--- a/Python/pytime.c	2026-05-04 00:20:59.878441742 +0000
+++ b/Python/pytime.c	2026-05-04 00:30:55.490511419 +0000
@@ -852,3 +852,59 @@
     return 0;
 #endif /* MS_WINDOWS */
 }
+
+/* ---- SCO OpenServer 5 clock shim ---------------------------------------
+ * SCO has no POSIX.1-2001 clock_gettime/clock_getres. We synthesize them
+ * on top of gettimeofday() (for CLOCK_REALTIME) and times() (for
+ * CLOCK_MONOTONIC). times()'s clock_t can wrap on long-running processes;
+ * adequate for typical Python use, NOT a substitute for real RT clocks.
+ */
+#ifdef SCO5
+#include <sys/time.h>
+#include <sys/times.h>
+#include <limits.h>
+
+int clock_gettime(clockid_t clk, struct timespec *ts) {
+    if (clk == CLOCK_REALTIME) {
+        struct timeval tv;
+        if (gettimeofday(&tv, NULL) != 0) return -1;
+        ts->tv_sec = tv.tv_sec;
+        ts->tv_nsec = (long)tv.tv_usec * 1000L;
+        return 0;
+    }
+    if (clk == CLOCK_MONOTONIC) {
+        struct tms t;
+        clock_t c = times(&t);
+        long hz = CLK_TCK;
+        if (c == (clock_t)-1) return -1;
+        ts->tv_sec = (long)(c / hz);
+        ts->tv_nsec = (long)((c % hz) * (1000000000L / hz));
+        return 0;
+    }
+    return -1;
+}
+
+int clock_getres(clockid_t clk, struct timespec *res) {
+    if (clk == CLOCK_REALTIME) {
+        res->tv_sec = 0;
+        res->tv_nsec = 1000L;  /* gettimeofday: microsecond */
+        return 0;
+    }
+    if (clk == CLOCK_MONOTONIC) {
+        long hz = CLK_TCK;
+        res->tv_sec = 0;
+        res->tv_nsec = 1000000000L / hz;
+        return 0;
+    }
+    return -1;
+}
+
+/* GIL state stubs for --without-threads. CPython 3.6 calls these
+ * from object.c and pylifecycle.c without WITH_THREAD guards.
+ * No-op implementations are safe in single-threaded builds. */
+#ifndef WITH_THREAD
+PyGILState_STATE PyGILState_Ensure(void) { return PyGILState_UNLOCKED; }
+void PyGILState_Release(PyGILState_STATE state) { (void)state; }
+PyThreadState *PyGILState_GetThisThreadState(void) { return NULL; }
+#endif
+#endif /* SCO5 */
